# Copy to .env and adjust. All are optional — safe defaults are baked in.

# SAFETY GUARDRAILS
AGENT_DRY_RUN=true              # true = run the full loop but never publish
AGENT_KILL_SWITCH=false         # true = hard-disable all publishing
AGENT_SPEND_CAP_USD=5.0         # stop/flag a run if projected cost exceeds this
AGENT_CONFIDENCE_THRESHOLD=0.7  # posts scoring below this are held, not published

